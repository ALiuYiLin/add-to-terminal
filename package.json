{
  "name": "add-to-terminal-workspace",
  "private": true,
  "version": "0.0.0",
  "description": "Monorepo: the Add to Terminal VS Code extension and its DSH bridge plugin.",
  "license": "MIT",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "check": "pnpm --filter dsh-add-to-terminal check",
    "compile": "pnpm --filter add-to-terminal compile",
    "vsix": "pnpm --filter add-to-terminal package",
    "publish:dsh": "pnpm --filter dsh-add-to-terminal publish --access public"
  }
}
