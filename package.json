{
  "name": "add-to-terminal",
  "displayName": "Add to Terminal",
  "description": "One-click send file references, line ranges, and diagnostics to the terminal — optimized for Claude Code CLI workflows",
  "version": "0.1.3",
  "publisher": "EeLynn",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ALiuYiLin/add-to-terminal"
  },
  "bugs": {
    "url": "https://github.com/ALiuYiLin/add-to-terminal/issues"
  },
  "homepage": "https://github.com/ALiuYiLin/add-to-terminal#readme",
  "icon": "icon.png",
  "keywords": [
    "claude-code",
    "terminal",
    "productivity",
    "file-reference",
    "diagnostics",
    "quick-fix"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:addToTerminal.addReference",
    "onCommand:addToTerminal.addFileReference",
    "onCommand:addToTerminal.sendDiagnostic"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "addToTerminal.addReference",
        "title": "Add to Terminal: File Reference"
      },
      {
        "command": "addToTerminal.addFileReference",
        "title": "Add to Terminal: File Path"
      },
      {
        "command": "addToTerminal.sendDiagnostic",
        "title": "Add to Terminal: Diagnostic"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "addToTerminal.addReference",
          "group": "navigation",
          "when": "editorTextFocus"
        }
      ],
      "explorer/context": [
        {
          "command": "addToTerminal.addFileReference",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "addToTerminal.addFileReference",
          "when": "false"
        },
        {
          "command": "addToTerminal.sendDiagnostic",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "command": "addToTerminal.addReference",
        "key": "ctrl+alt+t",
        "mac": "cmd+alt+t",
        "when": "editorTextFocus"
      }
    ],
    "configuration": {
      "title": "Add to Terminal",
      "properties": {
        "addToTerminal.pathFormat": {
          "type": "string",
          "enum": [
            "absolute",
            "relative",
            "basename"
          ],
          "default": "relative",
          "description": "Format of file path"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "lint": "eslint src --ext ts",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "@vscode/vsce": "^2.22.0",
    "eslint": "^8.54.0",
    "typescript": "^5.3.2"
  }
}
