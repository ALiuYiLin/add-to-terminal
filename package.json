{
  "name": "add-to-terminal",
  "displayName": "Add to Terminal",
  "description": "Quickly add file:line reference to terminal for Claude Code CLI",
  "version": "0.0.1",
  "publisher": "your-publisher-name",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:addToTerminal.addReference"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "addToTerminal.addReference",
        "title": "Add to Terminal: File Reference"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "addToTerminal.addReference",
          "group": "navigation",
          "when": "editorTextFocus"
        }
      ],
      "explorer/context": [
        {
          "command": "addToTerminal.addReference",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "addToTerminal.addReference",
        "key": "ctrl+alt+t",
        "mac": "cmd+alt+t",
        "when": "editorTextFocus"
      }
    ],
    "configuration": {
      "title": "Add to Terminal",
      "properties": {
        "addToTerminal.pathFormat": {
          "type": "string",
          "enum": [
            "absolute",
            "relative",
            "basename"
          ],
          "default": "relative",
          "description": "Format of file path"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "lint": "eslint src --ext ts",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "@vscode/vsce": "^2.22.0",
    "eslint": "^8.54.0",
    "typescript": "^5.3.2"
  }
}
