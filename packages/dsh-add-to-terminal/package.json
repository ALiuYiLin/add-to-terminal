{
  "name": "dsh-add-to-terminal",
  "version": "0.2.1",
  "description": "DSH bridge plugin: delivers code references from the Add to Terminal VS Code extension into the DSH Web composer draft.",
  "license": "MIT",
  "author": "EeLynn",
  "repository": {
    "type": "git",
    "url": "https://github.com/ALiuYiLin/dsh-add-to-terminal"
  },
  "homepage": "https://github.com/ALiuYiLin/dsh-add-to-terminal#readme",
  "bugs": {
    "url": "https://github.com/ALiuYiLin/dsh-add-to-terminal/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "add-to-terminal",
    "vscode",
    "composer",
    "file-reference"
  ],
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "main": "./lib/host.js",
  "exports": {
    ".": "./lib/host.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "icon": "./icon.svg",
  "scripts": {
    "build": "tsc -p .",
    "prepublishOnly": "npm run build",
    "check": "node test/host.cjs && node test/client.cjs"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "typescript": "^5.3.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
